<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_surface">

    <LinearLayout
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="7dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launch" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/widget_first" style="@style/WidgetPrimary" android:text="我的收藏" />

    <LinearLayout
        android:id="@+id/widget_pair"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/widget_second" style="@style/WidgetSecondary" android:text="常用网页" />

        <TextView android:id="@+id/widget_third" style="@style/WidgetSecondary" android:layout_marginStart="4dp" android:text="常用路线" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        style="@style/WidgetPrimary"
        android:text="@string/launch_widget_empty"
        android:visibility="gone" />
</LinearLayout>
